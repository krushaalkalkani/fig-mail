# Copy to .env.local for local dev, and set the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase project REST URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=your-supabase-url
# Supabase anon/publishable key (server-side only; the app only calls token-gated RPCs).
SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: service-role key. If set it is used instead of the anon key. Not required; prefer leaving it unset.
SUPABASE_SERVICE_KEY=

# Plaintext DB token; its sha256 hash must be stored in private.app_config (see supabase/migrations/0003).
FIG_DB_TOKEN=your-random-db-token
# Password for the web login screen.
APP_PASSWORD=your-app-password
# Optional: set to 1 to disable the login screen entirely (not recommended; anyone with the URL can read your mail).
AUTH_DISABLED=
# Random secret (32+ bytes) used to sign the session cookie.
SESSION_SECRET=your-random-session-secret

# The inbox address shown in the UI (build-time). Leave empty for a generic label.
NEXT_PUBLIC_INBOX_ADDRESS=you@example.com
